# Live-AI proxy key (DEV ONLY — read server-side by the Vite /api/claude
# middleware, NEVER bundled into client code). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Optional: override the model slug (defaults to anthropic/claude-sonnet-4.6).
# Any OpenRouter model works, e.g. openai/gpt-4o, google/gemini-2.5-pro.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Without a key, the Live-AI toggle silently falls back to the deterministic
# engine — the demo still runs 100% offline.
